{
  "expo": {
    "name": "Kumo",
    "slug": "kumo",
    "owner": "flor2021",
    "scheme": "kumo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F5",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5D5491"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pet.kumo.app"
    },
    "android": {
      "package": "pet.kumo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5D5491"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "note": "Los EXPO_PUBLIC_* van en .env para correr local y en variables de la cuenta de Expo para los builds de EAS: .env está gitignoreado y EAS solo sube lo que está en git.",
      "eas": {
        "projectId": "84ac9b9a-0447-407c-b4c3-3854f1f0db83"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
