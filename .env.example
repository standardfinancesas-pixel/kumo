# ─────────────────────────────────────────────────────────────
# Kumo · variables de entorno (copiá este archivo como .env.local
# en cada app y completá los valores). NUNCA subas .env.local a git.
# ─────────────────────────────────────────────────────────────

# Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor (route handlers / edge functions). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (mails transaccionales) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Mientras el dominio no esté verificado en Resend, dejar el remitente de prueba:
# los mails SOLO llegan a la casilla con la que se creó la cuenta de Resend.
# Con el dominio verificado, cambiar a "Kumo <hola@kumoclub.com.ar>".
RESEND_FROM="Kumo <onboarding@resend.dev>"
# A dónde van los avisos INTERNOS (cobro rechazado, alta nueva, baja, cuenta
# eliminada). Si no está, van al contacto público del club (`club_settings.email`).
# Existe porque ese contacto se publica en la web y la casilla que opera el club
# puede ser otra — y porque hoy `hola@kumo.pet` todavía no recibe mails.
MAIL_ADMIN=flor@cambalache.studio
# Para armar los links de los mails (en un mail no sirven las rutas relativas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Teselas del mapa (CARTO) ───────────────────────────────────
# CARTO dejó de servir basemaps sin clave (27/08/2026): sin esto los mapas de la
# web y de la app muestran "API KEY REQUIRED" en cada tesela. La clave se pide en
# https://carto.com/basemaps/apikey (formulario con email y dominio; llega por
# mail, sin cuenta ni aprobación) — gratis hasta 5 millones de teselas/mes y
# permite uso comercial. Es una clave PÚBLICA atada al dominio: va con prefijo
# NEXT_PUBLIC_/EXPO_PUBLIC_ a propósito. En la app viaja horneada en el bundle,
# así que además de acá va en las variables de la cuenta de Expo.
NEXT_PUBLIC_CARTO_KEY=
EXPO_PUBLIC_CARTO_KEY=

# Google Maps ────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-key

# App (Expo / móvil) ─────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-key
