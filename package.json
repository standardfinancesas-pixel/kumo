{
  "name": "kumo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @kumo/web dev",
    "dev:mobile": "pnpm --filter @kumo/mobile start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "comment": "Las apps web usan React 19 (lo exige el App Router de Next 15) y mobile React 18.2.0 (lo exige Expo 51). Sin este peerDependencyRules, pnpm llena la consola de warnings por esa convivencia.",
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}