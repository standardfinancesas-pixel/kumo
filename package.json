{
  "name": "kumo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @kumo/web dev",
    "dev:mobile": "pnpm --filter @kumo/mobile start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "comment": "Las tres superficies están en React 19. Este peerDependencyRules quedó de cuando mobile iba en 18.2.0 (Expo 51) y pnpm llenaba la consola de warnings por la convivencia; se deja porque hay dependencias del ecosistema RN que todavía declaran react ^18 como peer.",
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}
