auto-install-peers=true

# OJO: no volver a poner node-linker=hoisted.
#
# Estaba para que Metro (Expo) resolviera el monorepo, pero rompe el build de
# producción de Next 15: deja copias anidadas de React (una en
# node_modules/next/node_modules/react y otra en la raíz) y el prerender de
# /404 y /500 muere con "Cannot read properties of null (reading 'useContext')".
# En dev no se nota; solo aparece en `next build`.
#
# Tampoco hoistear los paquetes de React Native con public-hoist-pattern: al
# subirlos a la raíz quedan sin React al lado (React vive en apps/*/node_modules
# porque las web usan 19 y mobile 18), Metro termina cargando dos instancias y
# la app muere con "Objects are not valid as a React child".
#
# Lo que Metro necesita está resuelto en apps/mobile/metro.config.js.
#
# La única excepción es @babel/runtime: son los helpers que Babel inyecta en el
# código transpilado, y CADA paquete del ecosistema de Expo/RN los pide sin
# declararlos como dependencia (expo-modules-core falla con "Unable to resolve
# @babel/runtime/helpers/interopRequireDefault"). Hoistearlo es seguro porque no
# depende de React, así que no puede duplicar instancias como sí pasaba con los
# paquetes react-native-*.
public-hoist-pattern[]=@babel/runtime
#
# Lo mismo aplica a los paquetes internos del framework (@react-native/*, como
# assets-registry, que Metro usa para resolver las imágenes). Son utilidades sin
# React adentro, así que hoistearlos es seguro. OJO con la diferencia: los
# `react-native-*` de terceros (svg, web, maps) SÍ importan React y hoistearlos
# deja dos instancias — eso rompe la app con "Objects are not valid as a React
# child". No agregar ese patrón.
public-hoist-pattern[]=@react-native/*
